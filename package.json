{
  "name": "whatsapp-scheduler",
  "version": "0.1.5",
  "description": "Local desktop scheduler for WhatsApp chats and groups",
  "author": "blondahouse",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.ts && node scripts/buffer-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "pino": "10.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/qrcode": "1.5.6",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "@playwright/test": "1.63.0"
  },
  "build": {
    "appId": "house.blonda.whatsapp-scheduler",
    "productName": "WhatsApp Scheduler",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "WhatsAppScheduler-Setup-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/custom.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
