{
  "name": "whatsapp-scheduler",
  "version": "0.1.0",
  "description": "Local desktop scheduler for WhatsApp chats and groups",
  "author": "blondahouse",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "pino": "latest",
    "qrcode": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/qrcode": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "esbuild": "latest",
    "typescript": "latest",
    "@playwright/test": "latest"
  },
  "build": {
    "appId": "house.blonda.whatsapp-scheduler",
    "productName": "WhatsApp Scheduler",
    "directories": { "output": "release", "buildResources": "assets" },
    "files": ["dist/**/*", "ui/**/*", "assets/**/*", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "assets/icon.ico", "signAndEditExecutable": false },
    "nsis": {
      "artifactName": "WhatsAppScheduler-Setup-x64.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "installer/custom.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
